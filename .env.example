# Postgres connection string (e.g. from Neon: postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL="postgresql://user:password@localhost:5432/taskflow?schema=public"

# Secret for signing session JWTs. Use a long random string, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"
